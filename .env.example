# DeepSeek
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 本地 Qwen（OpenAI 兼容；LM Studio 默认监听 1234）
# 线上服务器要访问本机模型时，把 BASE_URL 换成隧道/内网可达的地址
QWEN_BASE_URL=http://127.0.0.1:1234/v1
QWEN_API_KEY=lm-studio
# 留空则从 /v1/models 里自动选第一个 qwen 模型
QWEN_MODEL=
QWEN_TIMEOUT=120
# qwen-proxy 的健康检查端口：只判断反向 SSH 隧道通不通（1235）
# 留空则跳过第一段，直接检查模型服务
QWEN_HEALTH_URL=http://127.0.0.1:1235/health

# PostgreSQL
PG_DSN=postgresql://postgres:postgres@localhost:5432/shopagent

# Embedding / Rerank
# MVP 默认用小的英文模型，CPU 上快很多；要中英混合可换 bge-m3（1024 维）
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
RERANK_MODEL=BAAI/bge-reranker-base

# HuggingFace 下载源。
# 能直连就用官方站；hf-mirror.com 会把请求 308 重定向回 huggingface.co，
# 新版 huggingface_hub 会因此报 FileMetadataError，不要用镜像。
HF_ENDPOINT=https://huggingface.co
